# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler_apple compiles each permission out unless its macro is
    # defined here. The defaults in PermissionHandlerEnums.h are 0, not 1 — so
    # without this block AudioVideoPermissionStrategy is never built, and
    # Permission.camera.request() returns denied instantly without ever reaching
    # AVFoundation. iOS then has no record of the app asking, which is why Camera
    # didn't appear under Settings for Ally at all and no prompt was ever shown.
    #
    # Only the camera is enabled: it's the one permission this app requests through
    # permission_handler (see TextScanner). image_picker, geolocator and
    # flutter_contacts each ask iOS directly through their own plugin code, so their
    # macros stay off — App Store review flags permission code for anything the app
    # doesn't actually use.
    # Appends rather than the ||= the plugin's own README shows: some pods already
    # carry a GCC_PREPROCESSOR_DEFINITIONS value, and ||= silently leaves those
    # targets untouched — which is the difference between this working and looking
    # like it was applied.
    target.build_configurations.each do |config|
      definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      definitions = [definitions] unless definitions.is_a?(Array)
      definitions << 'PERMISSION_CAMERA=1' unless definitions.include?('PERMISSION_CAMERA=1')
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
    end
  end
end
